# Copy to .env for local development. Never commit .env.
# In production (Render) set these as environment variables instead.

APP_ENV=development          # development | production | test
PORT=8080                    # Render sets this automatically

# Neon Postgres
DATABASE_URL=postgresql://user:password@HOST.neon.tech/db?sslmode=require                # direct: migrations, seed
DATABASE_URL_POOLED=postgresql://user:password@HOST-pooler.neon.tech/db?sslmode=require  # pooled: API runtime

# Neon object storage (S3 compatible), reserved for car photo uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Auth. Generate the secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Error reporting (leave empty to disable)
SENTRY_DSN=

# Customer contacts (kept only to trace a car after theft or misuse)
# Encrypts contacts at rest: openssl rand -base64 32. Losing it makes stored contacts unreadable.
CONTACTS_MASTER_KEY=
CONTACTS_RETENTION_DAYS=30           # auto-delete this long after the last ride
REQUIRE_CONTACTS_FOR_BOOKING=true    # booking is refused until contacts are synced

# One-time login codes. Only "console" (prints the code in the server log) exists so far,
# and it is refused when APP_ENV=production. An SMS provider must be added before launch.
OTP_PROVIDER=console
OTP_TTL=5m

# Push notifications: base64 of a Firebase service account JSON key. Optional;
# without it pushes are logged instead of sent. Create: base64 -i key.json | tr -d '\n'
FIREBASE_CREDENTIALS_B64=

# Browsers only. Mobile apps do not need CORS. Comma separated, never * in production.
CORS_ALLOWED_ORIGINS=

# How many reverse proxies sit in front of the API (0 locally). Controls which
# X-Forwarded-For entry is trusted for rate limiting. Verify the value on Render.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# First super admin, used only by `make seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=
